{
  "name": "grigdesk-tasks-driver",
  "version": "0.1.0",
  "description": "GrigTasks driver for GrigDesk TaskTracker contract 1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./driver.ts"
  },
  "files": [
    "driver.json",
    "driver.ts",
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
